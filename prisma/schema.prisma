datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   // "mentorado" | "admin"
  revenue   Float    @default(0.0)
  createdAt DateTime @default(now())
  
  // Relations
  tasks       UserTask[]
  submissions Submission[]
}

model UserTask {
  id          String   @id @default(uuid())
  userId      String
  taskId      String   // ID from the template (t1, t2, etc.)
  title       String
  description String
  phaseId     Int
  status      String   // "NOT_STARTED" | "PENDING_APPROVAL" | "APPROVED" | "REJECTED"
  evidenceType String  // "print" | "link" | "none"
  evidenceUrl  String?
  note         String?
  feedback     String?
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, taskId])
}

model Submission {
  id            String   @id @default(uuid())
  userId        String
  mentoradoName String
  taskId        String
  taskTitle     String
  evidenceUrl   String
  note          String?
  submittedAt   String
  status        String   // "PENDING" | "APPROVED" | "REJECTED"
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
